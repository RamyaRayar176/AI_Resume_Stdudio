{
  "name": "placement-ai-system-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend/frontend",
    "build:frontend": "npm run build --prefix backend/frontend",
    "start:frontend": "npm start --prefix backend/frontend",
    "start:backend": "python app.py",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "concurrently": "^8.2.2",
    "framer-motion": "^12.40.0",
    "react-chartjs-2": "^5.3.1",
    "react-circular-progressbar": "^2.2.0",
    "react-icons": "^5.6.0"
  }
}
